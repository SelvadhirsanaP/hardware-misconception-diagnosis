# Copy this file to ".env" and fill in your values. NEVER commit ".env" to GitHub.

# ---- Optional AI explanations (the app works without them) ----
# Provider: "anthropic" or "openai" (openai also works with any OpenAI-compatible server)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Only needed for OpenAI-compatible servers (default: https://api.openai.com/v1)
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=40

# ---- Optional: full paths to the tools if they are not on your PATH ----
# Example (Windows): IVERILOG_PATH=C:\iverilog\bin\iverilog.exe
IVERILOG_PATH=
VVP_PATH=
YOSYS_PATH=

# ---- Limits ----
TOOL_TIMEOUT_SECONDS=20
SIM_TIMEOUT_SECONDS=10
MAX_CODE_BYTES=200000

# ---- Server ----
PORT=5000
FLASK_DEBUG=0
